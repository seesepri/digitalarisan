NODE_ENV=production
APP_URL=https://your-domain.example
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BANK_PII_ENCRYPTION_KEY=replace-with-base64-32-byte-key
DATABASE_URL=postgresql://app_user:password@host:5432/database?sslmode=require

# Optional read replica. Only non-transactional read paths may use this.
READ_DATABASE_URL=
MIGRATION_DATABASE_URL=postgresql://migration_user:password@host:5432/database?sslmode=require
TRUST_PROXY=true
CRON_SECRET=replace-with-a-long-random-secret
JOB_WORKER_INTERVAL_MS=15000

# v16 database pool / timeout budget
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_MAX_LIFETIME_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=35000

# v16 provider resilience / backpressure
PROVIDER_TIMEOUT_MS=15000
PROVIDER_MAX_CONCURRENCY=32
PROVIDER_MAX_QUEUE=128
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_OPEN_MS=30000
SHUTDOWN_GRACE_MS=30000

PAYMENT_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=replace-with-midtrans-server-key
MIDTRANS_IS_PRODUCTION=true
PAYMENT_RETURN_URL=https://your-domain.example/payment/return

# Twilio Verify (real SMS OTP; provision separate Verify services for each purpose)
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID_SIGNUP=replace-with-signup-verify-service-sid
TWILIO_VERIFY_SERVICE_SID_LOGIN=replace-with-login-verification-service-sid
TWILIO_VERIFY_SERVICE_SID_PASSWORD_RESET=replace-with-password-reset-verify-service-sid

PAYOUT_PROVIDER=your-provider
PAYOUT_PROVIDER_BASE_URL=https://provider.example
PAYOUT_PROVIDER_API_KEY=replace-with-provider-secret
PAYOUT_PROVIDER_CREATE_PATH=/disbursements
PAYOUT_PROVIDER_STATUS_PATH=/disbursements/{reference}

METRICS_TOKEN=replace-with-a-long-random-metrics-token
RPO_TARGET_SECONDS=300
RTO_TARGET_SECONDS=3600
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups/postgres
COMPLIANCE_SINGLE_WITHDRAWAL_REVIEW_IDR=10000000
COMPLIANCE_DAILY_WITHDRAWAL_REVIEW_IDR=25000000
COMPLIANCE_HOURLY_WITHDRAWAL_COUNT_REVIEW=3
IMAGE_REPOSITORY=digital-arisan
RELEASE_SHA=replace-with-approved-git-sha
PRODUCTION_APP_URL=https://your-domain.example
REQUIRE_BACKUP=true

# v17 performance budgets / benchmarks
PERF_BENCHMARK_ALLOW=false
PERF_P95_HEALTH_MS=300
PERF_P95_READ_MS=500
PERF_MAX_ERROR_RATE=0.01
PERF_MIN_RPS=20

# v19 Enterprise Observability & SRE
OTEL_ENABLED=true
OTEL_SERVICE_NAME=digital-arisan
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
SRE_TOKEN=replace-with-a-long-random-sre-token
SYNTHETIC_BASE_URL=https://your-domain.example
SYNTHETIC_TIMEOUT_MS=5000
SYNTHETIC_MAX_LATENCY_MS=1000
INCIDENT_WEBHOOK_URL=
INCIDENT_WEBHOOK_SECRET=
INCIDENT_WEBHOOK_TIMEOUT_MS=5000
CAPACITY_P95_LIMIT_MS=750
FORECAST_HORIZON=12
