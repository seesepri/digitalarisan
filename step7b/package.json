{
  "type": "module",
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:concurrency": "tsx --tsconfig tsconfig.test.json --test tests/concurrency-idempotency.test.ts",
    "test:concurrency:watch": "tsx --tsconfig tsconfig.test.json --test --watch tests/concurrency-idempotency.test.mts",
    "test:payment-provider": "tsx --test tests/payment-provider.test.ts",
    "test:midtrans": "tsx --test tests/midtrans-payment-provider.test.ts",
    "test:job-locking": "tsx --test tests/job-locking.test.ts",
    "test:security": "tsx --test tests/security-hardening.test.ts",
    "test:integration": "bash scripts/test-integration.sh",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:load": "node --test tests/load/runtime-resilience.test.mjs",
    "load:stress": "node scripts/runtime/load-stress.mjs",
    "test:all": "npm run lint && npm run typecheck && npm run test:concurrency && npm run test:payment-provider && npm run test:midtrans && npm run test:job-locking && npm run test:security && npm run test:observability && npm run test:runtime-resilience && npm run test:integration",
    "test:observability": "tsx --test tests/observability.test.ts",
    "backup:postgres": "bash scripts/backup-postgres.sh",
    "verify:backup": "bash scripts/verify-backup.sh",
    "restore:postgres": "bash scripts/restore-postgres.sh",
    "restore:pitr": "bash scripts/pitr-restore.sh",
    "dr:verify": "bash scripts/dr/verify-restored-db.sh",
    "dr:migration-preflight": "bash scripts/dr/migration-preflight.sh",
    "compliance:retention-report": "bash scripts/compliance-retention-report.sh",
    "security:check": "bash scripts/deploy/security-gate.sh",
    "security:secrets": "bash scripts/deploy/check-secrets.sh",
    "deploy:migration-preflight": "bash scripts/deploy/migration-preflight.sh",
    "deploy:promote": "bash scripts/deploy/promote.sh",
    "deploy:rollback": "bash scripts/deploy/rollback.sh",
    "sbom": "bash scripts/deploy/generate-sbom.sh",
    "deploy:migrate": "bash scripts/deploy/zero-downtime-migration.sh",
    "runtime:limits": "node scripts/runtime/print-runtime-limits.mjs",
    "test:runtime-resilience": "tsx --test tests/runtime-resilience.test.ts",
    "perf:benchmark": "node scripts/performance/benchmark-queries.mjs",
    "perf:load": "node scripts/runtime/load-stress.mjs",
    "perf:budget": "node scripts/performance/check-budget.mjs",
    "perf:profile": "bash scripts/performance/profile-server.sh",
    "test:performance-budget": "node --test tests/performance/performance-budget.test.mjs",
    "api:contract-check": "node scripts/api/contract-check.mjs",
    "test:api-architecture": "node --test tests/api/architecture.test.mjs",
    "sre:synthetic": "node scripts/sre-synthetic-check.mjs",
    "sre:correlate": "node scripts/sre-alert-correlate.mjs",
    "sre:incident": "node scripts/sre-incident-dispatch.mjs",
    "sre:forecast": "node scripts/sre-capacity-forecast.mjs",
    "test:sre": "tsx --test tests/sre.test.ts",
    "test:payout-provider": "tsx --test tests/payout-provider.test.ts",
    "test:midtrans:sandbox": "MIDTRANS_E2E=1 tsx --test tests/e2e/midtrans-sandbox.test.ts",
    "test:payout:sandbox": "PAYOUT_E2E=1 tsx --test tests/e2e/payout-sandbox.test.ts",
    "load:settlement": "node scripts/runtime/load-settlement.mjs",
    "test:crash-recovery": "tsx --test tests/crash-restart-recovery.test.ts",
    "test:reconciliation-audit": "tsx --test tests/reconciliation-orphan-audit.test.ts",
    "test:provider-reconciliation": "tsx --test tests/reconciliation-orphan-audit.test.ts",
    "test:financial-security-audit": "tsx --test tests/financial-authorization-audit.test.ts",
    "test:privacy": "tsx --test tests/privacy.test.ts",
    "security:migrate-bank-pii": "node scripts/security/migrate-bank-pii.mjs",
    "security:verify-audit": "node scripts/security/verify-audit-integrity.mjs",
    "compliance:retention-enforce": "bash scripts/compliance-retention-enforce.sh"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "^16.4.0",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "4.1.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@10.9.2"
}
